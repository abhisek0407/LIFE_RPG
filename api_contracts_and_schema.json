{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Life RPG - API Contracts & Database Schema Specification",
  "version": "1.0.0",
  "description": "Comprehensive specification for Node.js + Express backend and MongoDB database, ensuring 100% consistency with the React frontend.",
  "metadata": {
    "targetStack": {
      "frontend": "React 18 (Vite, Tailwind CSS, Lucide)",
      "backend": "Node.js (Express.js)",
      "database": "MongoDB with Mongoose ODM",
      "authentication": "JWT (Bearer Token in Authorization header)"
    },
    "progressionFormulas": {
      "levelCurve": {
        "formula": "xpRequired = Math.floor(100 * Math.pow(level, 1.5))",
        "description": "Non-linear leveling curve where each successive level requires exponentially more XP.",
        "examples": {
          "level_1_to_2": 100,
          "level_2_to_3": 282,
          "level_3_to_4": 519,
          "level_4_to_5": 800,
          "level_5_to_6": 1118,
          "level_10_to_11": 3162
        }
      },
      "streakBonus": {
        "formula": "multiplier = 1.0 + Math.min(streakDays * 0.05, 0.50)",
        "description": "Adds 5% bonus XP per consecutive streak day, capped at +50% (1.5x) at 10 days."
      },
      "difficultyXpMatrix": {
        "easy": { "baseXp": 50, "baseGold": 15 },
        "medium": { "baseXp": 120, "baseGold": 35 },
        "hard": { "baseXp": 300, "baseGold": 80 }
      },
      "domains": ["health", "mental", "skill"],
      "domainDescriptions": {
        "health": "Vitality, physical workout, nutrition, hydration, sleep, and body constitution.",
        "mental": "Focus, studying, problem solving, mindfulness, emotional clarity, and stress relief.",
        "skill": "Creative craftsmanship, coding, professional mastery, social confidence, and reading."
      }
    }
  },
  "databaseSchemas": {
    "User": {
      "collection": "users",
      "description": "Core user account, credentials, character attributes, and overall progression state.",
      "schema": {
        "_id": { "type": "ObjectId", "auto": true },
        "username": { "type": "String", "required": true, "unique": true, "trim": true, "minlength": 3, "maxlength": 30 },
        "email": { "type": "String", "required": true, "unique": true, "lowercase": true, "trim": true },
        "passwordHash": { "type": "String", "required": true },
        "character": {
          "title": { "type": "String", "default": "Novice Seeker" },
          "avatar": { "type": "String", "default": "avatar_cyber_mage" },
          "overallLevel": { "type": "Number", "default": 1 },
          "totalXpEarned": { "type": "Number", "default": 0 },
          "gold": { "type": "Number", "default": 50 },
          "gems": { "type": "Number", "default": 5 }
        },
        "domains": {
          "health": {
            "level": { "type": "Number", "default": 1 },
            "currentXp": { "type": "Number", "default": 0 },
            "xpToNextLevel": { "type": "Number", "default": 100 }
          },
          "mental": {
            "level": { "type": "Number", "default": 1 },
            "currentXp": { "type": "Number", "default": 0 },
            "xpToNextLevel": { "type": "Number", "default": 100 }
          },
          "skill": {
            "level": { "type": "Number", "default": 1 },
            "currentXp": { "type": "Number", "default": 0 },
            "xpToNextLevel": { "type": "Number", "default": 100 }
          }
        },
        "streak": {
          "currentStreak": { "type": "Number", "default": 1 },
          "longestStreak": { "type": "Number", "default": 1 },
          "lastActivityDate": { "type": "Date", "default": "Date.now" },
          "streakFreezesAvailable": { "type": "Number", "default": 1 }
        },
        "inventory": [
          {
            "itemId": { "type": "String", "required": true },
            "name": { "type": "String", "required": true },
            "type": { "type": "String", "enum": ["potion", "badge", "theme", "relic", "freeze"] },
            "quantity": { "type": "Number", "default": 1 },
            "equipped": { "type": "Boolean", "default": false },
            "acquiredAt": { "type": "Date", "default": "Date.now" }
          }
        ],
        "createdAt": { "type": "Date", "default": "Date.now" },
        "updatedAt": { "type": "Date", "default": "Date.now" }
      }
    },
    "Quest": {
      "collection": "quests",
      "description": "Main task decomposed into a sequence of actionable microtasks.",
      "schema": {
        "_id": { "type": "ObjectId", "auto": true },
        "userId": { "type": "ObjectId", "ref": "User", "required": true, "index": true },
        "title": { "type": "String", "required": true, "trim": true },
        "domain": { "type": "String", "required": true, "enum": ["health", "mental", "skill"] },
        "difficulty": { "type": "String", "required": true, "enum": ["easy", "medium", "hard"], "default": "medium" },
        "motivationLevel": { "type": "String", "required": true, "enum": ["low", "medium", "high"], "default": "medium" },
        "status": { "type": "String", "enum": ["active", "completed", "archived"], "default": "active", "index": true },
        "totalXp": { "type": "Number", "required": true },
        "totalGold": { "type": "Number", "required": true },
        "earnedXp": { "type": "Number", "default": 0 },
        "earnedGold": { "type": "Number", "default": 0 },
        "microtasks": [
          {
            "_id": { "type": "ObjectId", "auto": true },
            "title": { "type": "String", "required": true },
            "order": { "type": "Number", "required": true },
            "xpReward": { "type": "Number", "required": true },
            "goldReward": { "type": "Number", "required": true },
            "isCompleted": { "type": "Boolean", "default": false },
            "completedAt": { "type": "Date", "default": null }
          }
        ],
        "createdAt": { "type": "Date", "default": "Date.now" },
        "completedAt": { "type": "Date", "default": null }
      }
    },
    "DailyQuest": {
      "collection": "daily_quests",
      "description": "Recurring daily habits and ritual quests reset every 24 hours.",
      "schema": {
        "_id": { "type": "ObjectId", "auto": true },
        "userId": { "type": "ObjectId", "ref": "User", "required": true, "index": true },
        "title": { "type": "String", "required": true },
        "description": { "type": "String" },
        "domain": { "type": "String", "required": true, "enum": ["health", "mental", "skill"] },
        "xpReward": { "type": "Number", "default": 25 },
        "goldReward": { "type": "Number", "default": 10 },
        "isCompletedToday": { "type": "Boolean", "default": false },
        "streakDays": { "type": "Number", "default": 0 },
        "lastCompletedDate": { "type": "String" },
        "createdAt": { "type": "Date", "default": "Date.now" }
      }
    },
    "StoreItem": {
      "collection": "store_items",
      "description": "Catalog of virtual items, consumables, cosmetic themes, and badges.",
      "schema": {
        "_id": { "type": "String", "required": true },
        "name": { "type": "String", "required": true },
        "description": { "type": "String", "required": true },
        "type": { "type": "String", "enum": ["potion", "freeze", "theme", "badge", "relic"], "required": true },
        "costGold": { "type": "Number", "required": true },
        "costGems": { "type": "Number", "default": 0 },
        "icon": { "type": "String", "required": true },
        "rarity": { "type": "String", "enum": ["common", "rare", "epic", "legendary"], "default": "common" },
        "effect": {
          "type": { "type": "String", "enum": ["xp_multiplier", "streak_freeze", "theme_unlock", "badge_grant"] },
          "value": { "type": "Mixed" },
          "durationMinutes": { "type": "Number", "default": 0 }
        }
      }
    },
    "ActivityLog": {
      "collection": "activity_logs",
      "description": "Audit trail of task completions, XP gains, level-ups, and purchases for anti-cheat verification.",
      "schema": {
        "_id": { "type": "ObjectId", "auto": true },
        "userId": { "type": "ObjectId", "ref": "User", "required": true, "index": true },
        "actionType": { "type": "String", "enum": ["microtask_completed", "quest_completed", "level_up", "item_purchased", "streak_checkin", "grounding_completed"], "required": true },
        "domain": { "type": "String", "enum": ["health", "mental", "skill", "global"] },
        "xpGained": { "type": "Number", "default": 0 },
        "goldGained": { "type": "Number", "default": 0 },
        "metadata": { "type": "Object" },
        "timestamp": { "type": "Date", "default": "Date.now", "index": true }
      }
    }
  },
  "restApiEndpoints": [
    {
      "category": "Authentication",
      "endpoint": "/api/auth/register",
      "method": "POST",
      "description": "Register a new player account and initialize stats.",
      "authRequired": false,
      "requestBody": {
        "username": "dragon_slayer_99",
        "email": "slayer@liferpg.dev",
        "password": "SecurePassword123!"
      },
      "successResponse": {
        "status": 201,
        "body": {
          "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "user": {
            "id": "65f0123abc456def78901234",
            "username": "dragon_slayer_99",
            "email": "slayer@liferpg.dev",
            "character": { "title": "Novice Seeker", "overallLevel": 1, "gold": 50, "gems": 5 },
            "domains": {
              "health": { "level": 1, "currentXp": 0, "xpToNextLevel": 100 },
              "mental": { "level": 1, "currentXp": 0, "xpToNextLevel": 100 },
              "skill": { "level": 1, "currentXp": 0, "xpToNextLevel": 100 }
            },
            "streak": { "currentStreak": 1, "longestStreak": 1 }
          }
        }
      }
    },
    {
      "category": "Authentication",
      "endpoint": "/api/auth/login",
      "method": "POST",
      "description": "Authenticate user and receive JWT session token.",
      "authRequired": false,
      "requestBody": {
        "email": "slayer@liferpg.dev",
        "password": "SecurePassword123!"
      },
      "successResponse": {
        "status": 200,
        "body": {
          "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "user": { "$ref": "#/databaseSchemas/User" }
        }
      }
    },
    {
      "category": "Authentication",
      "endpoint": "/api/auth/me",
      "method": "GET",
      "description": "Get currently logged in player profile and live stats.",
      "authRequired": true,
      "headers": { "Authorization": "Bearer <TOKEN>" },
      "successResponse": {
        "status": 200,
        "body": { "user": { "$ref": "#/databaseSchemas/User" } }
      }
    },
    {
      "category": "User Profile & Customization",
      "endpoint": "/api/users/profile",
      "method": "PATCH",
      "description": "Update player avatar, character title, avatar frame, aura, and persona archetype customization.",
      "authRequired": true,
      "headers": { "Authorization": "Bearer <TOKEN>" },
      "requestBody": {
        "character": {
          "avatar": "cyber_paladin",
          "avatarFrame": "neon_cyan",
          "avatarUrl": "https://...",
          "title": "Thomas Shelby (Apex Sigma)"
        }
      },
      "successResponse": {
        "status": 200,
        "body": {
          "success": true,
          "user": { "$ref": "#/databaseSchemas/User" }
        }
      }
    },
    {
      "category": "AI Services",
      "endpoint": "/api/ai/decompose",
      "method": "POST",
      "description": "Decomposes an overwhelming main task into sequenced microtasks adjusted for motivation and domain.",
      "authRequired": true,
      "headers": { "Authorization": "Bearer <TOKEN>" },
      "requestBody": {
        "task": "Study 3 chapters of Distributed Systems for Midterm",
        "domain": "mental",
        "difficulty": "medium",
        "motivationLevel": "low"
      },
      "successResponse": {
        "status": 200,
        "body": {
          "task": "Study 3 chapters of Distributed Systems for Midterm",
          "domain": "mental",
          "difficulty": "medium",
          "motivationLevel": "low",
          "estimatedTimeMinutes": 45,
          "totalXp": 120,
          "totalGold": 35,
          "microtasks": [
            { "id": "m1", "title": "Clear desk and place textbook & notebook open to Chapter 1", "order": 1, "xpReward": 20, "goldReward": 5 },
            { "id": "m2", "title": "Read Chapter 1 section headers & bold terms without memorizing (5 mins)", "order": 2, "xpReward": 25, "goldReward": 5 },
            { "id": "m3", "title": "Write down 3 core definitions (CAP theorem, Consensus, Replication)", "order": 3, "xpReward": 25, "goldReward": 10 },
            { "id": "m4", "title": "Skim Chapter 2 & 3 summary diagrams and highlight key equations", "order": 4, "xpReward": 25, "goldReward": 5 },
            { "id": "m5", "title": "Solve 2 flashcard questions on Ch 1-3 to seal memory mastery", "order": 5, "xpReward": 25, "goldReward": 10 }
          ]
        }
      }
    },
    {
      "category": "AI Services",
      "endpoint": "/api/ai/feel-stuck",
      "method": "POST",
      "description": "Generates gentle immediate grounding microtasks and somatic breathing exercises when user is paralyzed/overwhelmed.",
      "authRequired": true,
      "headers": { "Authorization": "Bearer <TOKEN>" },
      "requestBody": {
        "feelingContext": "Anxious about too many deadlines, can't start"
      },
      "successResponse": {
        "status": 200,
        "body": {
          "reassuranceMessage": "It is completely normal to freeze when overloaded. Let's do 2 minutes of somatic regulation to drop your cortisol.",
          "breathingGuide": {
            "type": "box_breathing",
            "inhaleSeconds": 4,
            "hold1Seconds": 4,
            "exhaleSeconds": 4,
            "hold2Seconds": 4,
            "recommendedCycles": 4
          },
          "groundingMicrotasks": [
            { "id": "stuck_1", "title": "Plant both feet flat on the floor, drop shoulders, and inhale deeply", "domain": "mental", "xpReward": 15, "goldReward": 5 },
            { "id": "stuck_2", "title": "Drink one full glass of cold water to activate parasympathetic system", "domain": "health", "xpReward": 15, "goldReward": 5 },
            { "id": "stuck_3", "title": "Write down the single next 2-minute physical action on a scrap paper", "domain": "mental", "xpReward": 20, "goldReward": 10 }
          ]
        }
      }
    },
    {
      "category": "Quests & Microtasks",
      "endpoint": "/api/quests",
      "method": "GET",
      "description": "Retrieve all quests for the authenticated user, filterable by status (all, active, not_started, partially_conquered, conquered/completed).",
      "authRequired": true,
      "queryParams": {
        "status": {
          "type": "string",
          "enum": ["all", "active", "not_started", "partially_conquered", "conquered", "completed"],
          "default": "all",
          "description": "Filter quests by progress state. not_started: 0 microtasks completed; partially_conquered: 1+ microtasks completed but not all; conquered/completed: all microtasks finished."
        },
        "domain": {
          "type": "string",
          "enum": ["all", "health", "mental", "skill"],
          "default": "all"
        }
      },
      "successResponse": {
        "status": 200,
        "body": {
          "quests": [
            {
              "_id": "65f0456def7890123456789a",
              "title": "Study 3 chapters of Distributed Systems",
              "domain": "mental",
              "difficulty": "medium",
              "motivationLevel": "low",
              "status": "active",
              "totalXp": 120,
              "totalGold": 35,
              "earnedXp": 45,
              "earnedGold": 10,
              "microtasks": [
                { "_id": "65f0456def7890123456789b", "title": "Clear desk and open notebook", "order": 1, "xpReward": 20, "goldReward": 5, "isCompleted": true, "completedAt": "2026-09-12T06:45:00Z" },
                { "_id": "65f0456def7890123456789c", "title": "Read Chapter 1 section headers", "order": 2, "xpReward": 25, "goldReward": 5, "isCompleted": true, "completedAt": "2026-09-12T06:50:00Z" },
                { "_id": "65f0456def7890123456789d", "title": "Write down 3 core definitions", "order": 3, "xpReward": 25, "goldReward": 10, "isCompleted": false, "completedAt": null }
              ]
            }
          ]
        }
      }
    },
    {
      "category": "Quests & Microtasks",
      "endpoint": "/api/quests",
      "method": "POST",
      "description": "Create a new quest with decomposed microtasks.",
      "authRequired": true,
      "requestBody": {
        "title": "Gym Leg Day & Mobility Workout",
        "domain": "health",
        "difficulty": "medium",
        "motivationLevel": "medium",
        "microtasks": [
          { "title": "Put on gym gear and drink pre-workout water", "order": 1, "xpReward": 20, "goldReward": 5 },
          { "title": "5 minutes dynamic hip & ankle mobility stretches", "order": 2, "xpReward": 30, "goldReward": 10 },
          { "title": "3 sets of Goblet Squats with controlled tempo", "order": 3, "xpReward": 40, "goldReward": 10 },
          { "title": "2 sets of walking lunges & post-stretch", "order": 4, "xpReward": 30, "goldReward": 10 }
        ]
      },
      "successResponse": {
        "status": 201,
        "body": { "quest": { "$ref": "#/databaseSchemas/Quest" } }
      }
    },
    {
      "category": "Quests & Microtasks",
      "endpoint": "/api/quests/:questId/microtasks/:microtaskId/complete",
      "method": "PATCH",
      "description": "Mark a microtask complete. Calculates XP, applies streak multipliers, awards gold, updates domain progress, checks level-up.",
      "authRequired": true,
      "successResponse": {
        "status": 200,
        "body": {
          "microtaskId": "65f0456def7890123456789d",
          "isCompleted": true,
          "xpAwarded": 25,
          "goldAwarded": 10,
          "streakMultiplier": 1.15,
          "domain": "mental",
          "domainState": {
            "level": 2,
            "currentXp": 45,
            "xpToNextLevel": 282,
            "leveledUp": false
          },
          "userGold": 85,
          "questCompleted": false
        }
      }
    },
    {
      "category": "Quests & Microtasks",
      "endpoint": "/api/quests/:id",
      "method": "DELETE",
      "description": "Delete a quest and its microtasks.",
      "authRequired": true,
      "successResponse": {
        "status": 200,
        "body": { "message": "Quest deleted successfully" }
      }
    },
    {
      "category": "Daily Quests",
      "endpoint": "/api/daily-quests",
      "method": "GET",
      "description": "Get list of recurring daily quests with current completion status for today.",
      "authRequired": true,
      "successResponse": {
        "status": 200,
        "body": {
          "dailyQuests": [
            { "_id": "d1", "title": "Morning Sunlight & 500ml Water", "domain": "health", "xpReward": 25, "goldReward": 10, "isCompletedToday": false, "streakDays": 4 },
            { "_id": "d2", "title": "Deep Focus Reading (20 minutes)", "domain": "mental", "xpReward": 35, "goldReward": 15, "isCompletedToday": true, "streakDays": 7 },
            { "_id": "d3", "title": "Commit 1 Clean Code Improvement", "domain": "skill", "xpReward": 30, "goldReward": 10, "isCompletedToday": false, "streakDays": 2 }
          ]
        }
      }
    },
    {
      "category": "Daily Quests",
      "endpoint": "/api/daily-quests/:id/complete",
      "method": "PATCH",
      "description": "Toggle or complete a daily quest for the current day.",
      "authRequired": true,
      "successResponse": {
        "status": 200,
        "body": { "success": true, "xpAwarded": 25, "goldAwarded": 10, "streakDays": 5 }
      }
    },
    {
      "category": "Store & Inventory",
      "endpoint": "/api/store/items",
      "method": "GET",
      "description": "Retrieve catalog of items available in the Armory / Store.",
      "authRequired": true,
      "successResponse": {
        "status": 200,
        "body": {
          "items": [
            {
              "_id": "potion_focus",
              "name": "Elixir of Deep Mind",
              "description": "Grants +25% Mental XP for the next 2 hours.",
              "type": "potion",
              "costGold": 80,
              "icon": "potion",
              "rarity": "rare"
            },
            {
              "_id": "phoenix_feather",
              "name": "Phoenix Feather (Streak Freeze)",
              "description": "Protects your streak if you miss a calendar day.",
              "type": "freeze",
              "costGold": 150,
              "icon": "feather",
              "rarity": "epic"
            },
            {
              "_id": "badge_grandmaster",
              "name": "Cerebral Grandmaster Crest",
              "description": "Exclusive title and holographic avatar frame.",
              "type": "badge",
              "costGold": 300,
              "icon": "shield",
              "rarity": "legendary"
            }
          ]
        }
      }
    },
    {
      "category": "Store & Inventory",
      "endpoint": "/api/store/buy",
      "method": "POST",
      "description": "Purchase an item using earned in-game Gold.",
      "authRequired": true,
      "requestBody": { "itemId": "potion_focus" },
      "successResponse": {
        "status": 200,
        "body": {
          "success": true,
          "remainingGold": 45,
          "purchasedItem": { "itemId": "potion_focus", "name": "Elixir of Deep Mind", "quantity": 1 }
        }
      }
    },
    {
      "category": "Streaks & Calendar",
      "endpoint": "/api/streaks",
      "method": "GET",
      "description": "Get current streak, historical 30-day activity map, and streak multiplier.",
      "authRequired": true,
      "successResponse": {
        "status": 200,
        "body": {
          "currentStreak": 5,
          "longestStreak": 12,
          "multiplier": 1.25,
          "freezesAvailable": 1,
          "recentDays": [
            { "date": "2026-09-08", "tasksCompleted": 4, "active": true },
            { "date": "2026-09-09", "tasksCompleted": 6, "active": true },
            { "date": "2026-09-10", "tasksCompleted": 3, "active": true },
            { "date": "2026-09-11", "tasksCompleted": 5, "active": true },
            { "date": "2026-09-12", "tasksCompleted": 2, "active": true }
          ]
        }
      }
    }
  ]
}
